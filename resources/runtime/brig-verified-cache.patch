+package verify
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// Tugboat sets this only for its checked project plans. The directory is
+// private to the host, outside both project mounts. A receipt binds the
+// immutable digest to the exact publisher policy which verified it.
+func desktopReceipt(policy Policy, ref string) string {
+	root := os.Getenv("TUGBOAT_VERIFICATION_CACHE")
+	if !filepath.IsAbs(root) {
+		return ""
+	}
+	return filepath.Join(root, fmt.Sprintf("%x.verified", sha256.Sum256([]byte(strings.Join([]string{policy.Registry, policy.Identity, policy.Issuer, ref}, "\x00")))))
+}
+
+func saveDesktopRecord(file string, data []byte) error {
+	if file == "" {
+		return nil
+	}
+	dir := filepath.Dir(file)
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return err
+	}
+	temp, err := os.CreateTemp(dir, ".record-")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(temp.Name())
+	if _, err = temp.Write(data); err != nil {
+		temp.Close()
+		return err
+	}
+	if err = temp.Close(); err != nil {
+		return err
+	}
+	return os.Rename(temp.Name(), file)
+}
+
+func (p Policy) verifiedOffline(ref, local, resolved string, failure Result) Result {
+	file := desktopReceipt(p, ref)
+	if file == "" {
+		return failure
+	}
+	data, err := os.ReadFile(file)
+	digest := string(data)
+	if err != nil || !isDigest(digest) || (local != "" && local != digest) || (resolved != "" && resolved != digest) {
+		return failure
+	}
+	if _, pin, pinned := strings.Cut(ref, "@"); pinned {
+		if pin != digest {
+			return failure
+		}
+	} else if !strings.HasPrefix(ref, BootAssetsPolicy().Registry) || p.Identity != BootAssetsPolicy().Identity {
+		return failure
+	}
+	return Result{Policy: p, Outcome: Verified, Image: ref, Digest: digest, Ours: true}
+}
