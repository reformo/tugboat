@@ -0,0 +1,34 @@
+package verify
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func TestDesktopOfflineVerification(t *testing.T) {
+	t.Setenv("TUGBOAT_VERIFICATION_CACHE", t.TempDir())
+	p := DefaultPolicy()
+	digest := "sha256:" + strings.Repeat("a", 64)
+	ref := p.Registry + "example@" + digest
+	digestStub(t, digest, nil, nil)
+	if result := p.Verify(ref, ""); result.Outcome != Verified {
+		t.Fatal(result)
+	}
+	digestStub(t, "", errTimedOut, nil)
+	if result := p.Verify(ref, digest); result.Outcome != Verified {
+		t.Fatal(result)
+	}
+	if result := p.Verify(ref, "sha256:"+strings.Repeat("b", 64)); result.Outcome == Verified {
+		t.Fatal("wrong local digest")
+	}
+	other := p
+	other.Identity += "different"
+	if result := other.Verify(ref, ""); result.Outcome == Verified {
+		t.Fatal("changed publisher")
+	}
+	digestStub(t, digest, nil, errors.New("bad signature"))
+	if result := p.Verify(ref, ""); result.Outcome != Failed {
+		t.Fatal("accepted bad signature")
+	}
+}
