@@ -0,0 +1,65 @@
+package wrap
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/brig-sh/brig/internal/creds"
+	"github.com/brig-sh/brig/internal/verify"
+)
+
+func TestDesktopOfflineRetryPreservesRecordedHome(t *testing.T) {
+	state, _ := isolateHome(t)
+	state, err := filepath.EvalSymlinks(state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("BRIG_STATE_DIR", state)
+	options := Options{Name: "project-a"}
+	session := mustLoad(t, options)
+	bootHome(t, session)
+	transcripts := filepath.Join(session.Workspace, ".claude", "projects", "-work-project-a")
+	if err := os.MkdirAll(transcripts, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	for _, id := range []string{"first", "second"} {
+		if err := os.WriteFile(filepath.Join(transcripts, id+".jsonl"), []byte(id), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Setenv("BRIG_NETWORK", "offline")
+	failed := &bootFailRuntime{}
+	attempt := mustLoad(t, options)
+	attempt.Runtime, attempt.Verify = failed, verify.Off
+	failure := attempt.EnsureRunning(creds.Set{})
+	if failure == nil || failed.boots != 1 {
+		t.Fatalf("the Offline attempt did not fail during boot: %v", failure)
+	}
+	PruneSessions(nil)
+	retry := mustLoad(t, options)
+	retry.Runtime = &desktopRetryRuntime{livenessRuntime{workspace: session.Workspace}}
+	retry.Verify = verify.Off
+	retry.Profile.Volumes, retry.Profile.Files = nil, nil
+	if err := retry.EnsureRunning(creds.Set{}); err != nil {
+		t.Fatal(err)
+	}
+	for _, id := range []string{"first", "second"} {
+		data, err := os.ReadFile(filepath.Join(transcripts, id+".jsonl"))
+		if err != nil || string(data) != id {
+			t.Fatalf("retry lost transcript %s: %v", id, err)
+		}
+	}
+	retry.Runtime = &removingRuntime{}
+	if err := retry.Remove(); err != nil || retry.HomeErr != nil {
+		t.Fatalf("explicit removal: %v, home: %v", err, retry.HomeErr)
+	}
+	if _, err := os.Stat(session.Workspace); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("explicit removal left the guest home: %v", err)
+	}
+}
+
+type desktopRetryRuntime struct{ livenessRuntime }
+
+func (*desktopRetryRuntime) Exists(string) (bool, error) { return false, nil }
diff --git a/internal/wrap/desktop_stop_test.go b/internal/wrap/desktop_stop_test.go
new file mode 100644
