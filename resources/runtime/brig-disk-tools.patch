--- /dev/null
+++ b/internal/wrap/desktop_stop_test.go
@@ -0,0 +1,50 @@
+package wrap
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/brig-sh/brig/internal/runtime"
+)
+
+func TestDesktopStopDoesNotHideHullCleanupFailure(t *testing.T) {
+	t.Setenv("BRIG_RUNTIME", "hull")
+	t.Setenv("DO_NOT_TRACK", "1")
+	t.Setenv("BRIG_STATE_DIR", filepath.Join(t.TempDir(), "state"))
+	t.Setenv("BRIG_GATEWAY_DIR", t.TempDir())
+	bin := filepath.Join(t.TempDir(), "hull")
+	const script = `#!/bin/sh
+case "$1" in
+  stop) printf 'failed to reap the recorded virtual machine\n' >&2; exit 1 ;;
+  inspect)
+    if [ "$TUGBOAT_STOP_TEST_STATE" = absent ]; then
+      printf 'error: instance not found: %s\n' "$2" >&2; exit 1
+    fi
+    printf '{"id":"%s","status":"stopped"}\n' "$2" ;;
+  ps) printf '%s stopped\n' "$TUGBOAT_STOP_TEST_VM" ;;
+  *) exit 9 ;;
+esac
+`
+	if err := os.WriteFile(bin, []byte(script), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("BRIG_RUNTIME_BIN", bin)
+	c := testConfig(t, t.TempDir(), t.TempDir())
+	c.broker = &fakeBroker{}
+	t.Setenv("TUGBOAT_STOP_TEST_VM", c.VMName)
+	t.Setenv("TUGBOAT_STOP_TEST_STATE", "stopped")
+	var err error
+	c.Runtime, err = runtime.Detect()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Stop(); err == nil || !strings.Contains(err.Error(), "failed to reap the recorded virtual machine") {
+		t.Errorf("the stop did not report Hull's cleanup error: %v", err)
+	}
+	t.Setenv("TUGBOAT_STOP_TEST_STATE", "absent")
+	if err := c.Stop(); err != nil {
+		t.Errorf("stopping an absent Hull instance failed: %v", err)
+	}
+}
