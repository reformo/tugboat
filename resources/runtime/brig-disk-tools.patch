+package runtime
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+const desktopSandbox = "brig-desktop-fixture"
+
+func desktopLifecycleHull(t *testing.T, state string) *hull {
+	t.Helper()
+	directory := filepath.Join(t.TempDir(), "Fixture App.app", "Contents", "MacOS")
+	if err := os.MkdirAll(directory, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Exercise gateway recognition with a space in the actual executable path.
+	helper := filepath.Join(directory, "gateway-helper")
+	if err := os.Link(self, helper); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("DO_NOT_TRACK", "1")
+	t.Setenv("TUGBOAT_GATEWAY_TEST_HELPER", helper)
+	t.Setenv("TUGBOAT_GATEWAY_TEST_STATE", state)
+	bin := filepath.Join(directory, "hull")
+	script := `#!/bin/sh
+case "$1" in
+  network-gateway) BRIG_TEST_GATEWAY_HELPER=1 exec "$TUGBOAT_GATEWAY_TEST_HELPER" -test.run='^TestGatewayHelperProcess$' -- "$@" ;;
+  run) printf 'fixture boot failed\n' >&2; exit 3 ;;
+  stop)
+    if [ "$TUGBOAT_GATEWAY_TEST_STATE" = stop-succeeded ]; then exit 0; fi
+    printf 'fixture stop failed\n' >&2; exit 4 ;;
+  inspect)
+    case "$TUGBOAT_GATEWAY_TEST_STATE" in
+      absent) printf 'error: instance not found: %s\n' "$2" >&2; exit 1 ;;
+      running|starting|creating|stopped) printf '{"id":"%s","status":"%s"}\n' "$2" "$TUGBOAT_GATEWAY_TEST_STATE" ;;
+      *) printf 'error: could not read store containing instance not found: %s\n' "$2" >&2; exit 1 ;;
+    esac ;;
+  *) exit 9 ;;
+esac
+`
+	if err := os.WriteFile(bin, []byte(script), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	return &hull{bin: bin}
+}
+
+func TestDesktopFailedIsolatedBootReleasesOnlyItsGateway(t *testing.T) {
+	shared := scratchSharedGateway(t)
+	sharedPID := startHelperGateway(t, shared, true, false)
+	sibling := mustSocket(t, "brig-sibling")
+	siblingPID := startHelperGateway(t, sibling, true, false)
+	writeGatewayRecord(sibling, siblingPID, "sibling gateway")
+	sock := mustSocket(t, desktopSandbox)
+	t.Cleanup(func() { killGatewaysOn(sock) })
+
+	h := desktopLifecycleHull(t, "absent")
+	err := h.Run(RunSpec{Name: desktopSandbox, Image: "fixture", Hypervisor: "hvi", Net: "isolated"})
+	if err == nil || !strings.Contains(err.Error(), "fixture boot failed") {
+		t.Fatalf("expected the boot failure, got %v", err)
+	}
+	if gatewayReachable(sock) {
+		t.Fatal("the failed boot left its isolated gateway running")
+	}
+	if _, err := os.Stat(gatewayPIDPath(sock)); !errors.Is(err, os.ErrNotExist) {
+		t.Errorf("the failed boot left its PID record: %v", err)
+	}
+	if !alive(siblingPID) || !alive(sharedPID) {
+		t.Fatal("the failed boot stopped a sibling or shared gateway")
+	}
+}
+
+func TestDesktopFailedStopChecksExactInstanceAbsence(t *testing.T) {
+	for _, state := range []string{"absent", "running", "starting", "creating", "stopped", "unknown"} {
+		t.Run(state, func(t *testing.T) {
+			scratchSharedGateway(t)
+			sock := mustSocket(t, desktopSandbox)
+			pid := startHelperGateway(t, sock, true, false)
+			writeGatewayRecord(sock, pid, "target gateway")
+			absent := state == "absent"
+			err := desktopLifecycleHull(t, state).Stop(desktopSandbox)
+			if (err == nil) != absent {
+				t.Errorf("stop returned %v for state %q", err, state)
+			}
+			if absent {
+				for deadline := time.Now().Add(time.Second); alive(pid) && time.Now().Before(deadline); {
+					time.Sleep(10 * time.Millisecond)
+				}
+			}
+			if alive(pid) == absent || gatewayReachable(sock) == absent {
+				t.Errorf("gateway lifetime was wrong for state %q", state)
+			}
+		})
+	}
+}
+
+func TestDesktopFailedStopPreservesGatewayDuringAnotherBoot(t *testing.T) {
+	scratchSharedGateway(t)
+	sock := mustSocket(t, desktopSandbox)
+	pid := startHelperGateway(t, sock, true, false)
+	writeGatewayRecord(sock, pid, "target gateway")
+	_, release, err := leaseSharedGateway(sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer release()
+	if err := desktopLifecycleHull(t, "absent").Stop(desktopSandbox); err == nil {
+		t.Fatal("stop reported completion while a boot still held the gateway")
+	}
+	if !alive(pid) || !gatewayReachable(sock) {
+		t.Fatal("stop disconnected a gateway that a boot still held")
+	}
+}
+
+func TestDesktopStopReportsUnreleasedIsolatedGateway(t *testing.T) {
+	shared := scratchSharedGateway(t)
+	sharedPID := startHelperGateway(t, shared, true, false)
+	sock := mustSocket(t, desktopSandbox)
+	pid := startHelperGateway(t, sock, true, false)
+	writeGatewayRecord(sock, sharedPID, "stale PID record")
+	h := desktopLifecycleHull(t, "stop-succeeded")
+
+	if err := h.Stop(desktopSandbox); err == nil || !strings.Contains(err.Error(), "could not stop the isolated gateway") {
+		t.Fatalf("stop did not report the live gateway: %v", err)
+	}
+	if !alive(sharedPID) || !gatewayReachable(sock) {
+		t.Fatal("the stop signaled a process without the target's identity")
+	}
+
+	writeGatewayRecord(sock, pid, "target gateway")
+	if err := h.Stop(desktopSandbox); err != nil {
+		t.Fatalf("could not stop the recorded gateway: %v", err)
+	}
+	if alive(pid) || gatewayReachable(sock) || !alive(sharedPID) {
+		t.Fatal("stop ended the wrong gateway or failed to reap its own gateway")
+	}
+}
